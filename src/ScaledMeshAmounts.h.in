#pragma once

#include <vector>

// ##########################################################################################
// Please note! The content of this file is automatically modified by the CMake build system
// which replaces the variables. Generated from cmake/scale_test_meshes.cmake's
// KD_TREE_SCALED_MESH_AMOUNTS - the single source of truth also consumed by
// script/scale_mesh.py (via test/CMakeLists.txt) to generate the scaled benchmark meshes on disk.
// ##########################################################################################

namespace kdtree {

    /**
     * The face/node counts of the progressively larger scaled mesh variants (of the Eros and
     * sphere base meshes) generated for benchmarking. See cmake/scale_test_meshes.cmake.
     * The value is set by the CMake configuration.
     */
    inline const std::vector<long long> scaledMeshFaceAmounts{@KD_TREE_SCALED_MESH_AMOUNTS_CPP@};

    /**
     * Number of leading entries in scaledMeshFaceAmounts that are benchmarked with every
     * plane-selection algorithm (see REGISTER_MESH_BENCHMARKS in kd_time_main.cpp). Entries beyond
     * this count are only benchmarked with the LOG/LOGSQUARED algorithms, since NOTREE/QUADRATIC
     * don't scale to larger mesh sizes. The value is set by the CMake configuration.
     */
    inline constexpr long long scaledMeshFullAlgorithmCount = @KD_TREE_SCALED_MESH_FULL_ALGORITHM_COUNT@;

}// namespace kdtree
